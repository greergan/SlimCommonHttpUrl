}; */

	struct URL {
		URL();
		URL(const std::string& _string);

		static const slim::SlimValue can_parse(std::string_view _string);
		const bool is_valid() const;
		void parse(const std::string& _string);


		const std::optional<std::string> hash() const;
		const std::optional<std::string> host() const;
		const std::optional<std::string> hostname() const;
		const std::optional<std::string> href() const;
		const std::optional<std::string> origin() const;
		const std::optional<std::string> password() const;
		const std::optional<std::string> pathname() const;
		const std::optional<std::string> port() const;
		const std::optional<std::string> protocol() const;
		const std::optional<std::string> search() const;
		const std::optional<std::string> searchParams() const;
		const std::optional<std::string> username() const;
		const std::optional<std::string> url() const;

