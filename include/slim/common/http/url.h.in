#ifndef __SLIM__COMMON__HTTP__URL__H
#define __SLIM__COMMON__HTTP__URL__H

#include <optional>
#include <string>
#include <string_view>
#include <slim/common/log.h>
#include <slim/SlimValue.hpp>

#define SLIMCOMMONHTTPURL_VERSION "@SLIMCOMMONHTTPURL_VERSION@"
#define SLIMCOMMONHTTPURL_GIT_HASH "@SLIMCOMMONHTTPURL_GIT_HASH@"

namespace slim::common::http::url {
	slim::SlimValue can_parse(std::string_view _string);
	std::string_view control_character_to_string_view(const unsigned char _character);
};
namespace slim::common::http {
	struct URL {
		URL();
		URL(std::string_view _string);
		URL(std::string_view _string, const slim::SlimValue& parse_hints);

		static slim::SlimValue can_parse(std::string_view _string);
		void parse(const slim::SlimValue& _parse_hints);

		std::string hash() const;
		std::string host() const;
		std::string hostname() const;
		std::string href() const;
		std::string origin() const;
		std::string password() const;
		std::string pathname() const;
		std::string port() const;
		std::string protocol() const;
		std::string search() const;
		std::string searchParams() const;
		std::string username() const;

		private:
    		std::string __hash;
    		std::string __host;
			std::string __hostname;
			std::string __href;
			std::string __origin;
			std::string __password;
			std::string __pathname;
    		std::string __port;
			std::string __protocol;
    		std::string __search;
			std::string __searchParams;
    		std::string __username;
    };
};

#endif