#ifndef __SLIM__COMMON__HTTP__URL__H
#define __SLIM__COMMON__HTTP__URL__H

#include <optional>
#include <string>
#include <string_view>
#include <slim/common/log.h>
#include <slim/SlimValue.hpp>

#define SLIMCOMMONHTTPURL_VERSION "@SLIMCOMMONHTTPURL_VERSION@"
#define SLIMCOMMONHTTPURL_GIT_HASH "@SLIMCOMMONHTTPURL_GIT_HASH@"

namespace slim::common::http::url {
	slim::SlimValue can_parse(std::string_view _string);
	std::string_view control_character_to_string_view(const unsigned char _character);
};
namespace slim::common::http {
	struct URL {
		URL();
		URL(std::string_view _string);

		static slim::SlimValue can_parse(std::string_view _string);
		bool is_valid() const;
		//void parse(std::string_view _string);

		std::optional<std::string> hash() const;
		std::optional<std::string> host() const;
		std::optional<std::string> hostname() const;
		std::optional<std::string> href() const;
		std::optional<std::string> origin() const;
		std::optional<std::string> password() const;
		std::optional<std::string> pathname() const;
		std::optional<std::string> port() const;
		std::string                protocol() const;
		std::optional<std::string> search() const;
		std::optional<std::string> searchParams() const;
		std::optional<std::string> username() const;
		std::optional<std::string> url() const;

		private:
    		std::optional<std::string> __hash;
    		std::optional<std::string> __host;
			std::optional<std::string> __hostname;
			std::optional<std::string> __href;
			std::optional<std::string> __origin;
			std::optional<std::string> __password;
			std::optional<std::string> __pathname;
    		std::optional<std::string> __port;
			std::string                __protocol;
    		std::optional<std::string> __search;
			std::optional<std::string> __searchParams;
			std::optional<std::string> __url;
    		std::optional<std::string> __username;
			bool __is_valid = true;
    };
};

#endif