	static void handle_protocol(URLParser& parser, char character) {
		auto error_map = parser.return_value.get_multi_map("errors");

		if(parser.protocol_range.first == -1) {
			parser.protocol_range.first = parser.position;
		}

		if(character == ':') {
			parser.protocol_range.second = parser.position;
			parser.state = ParseState::AUTHORITY;
		}
		else if(!((character >= 'a' && character <= 'z') ||
				  (character >= 'A' && character <= 'Z') ||
				  (character >= '0' && character <= '9') ||
