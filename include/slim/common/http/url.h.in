namespace slim::common::http {
	enum struct ParseState : uint8_t {
		PROTOCOL,
		AUTHORITY,
		HOST,
		PORT,
		PATH,
		SEARCH,
		SEARCH_PARAMS,
		FRAGMENT,
		INVALID
	};

