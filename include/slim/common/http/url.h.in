	static void handle_host(URLParser& parser, char character) {
		auto error_map = parser.return_value.get_multi_map("errors");

		if(parser.host_range.first == -1) {
			parser.host_range.first = parser.position;
		}

		if(character == '/' || character == ':' || character == '?' || character == '#') {
			parser.host_range.second = parser.position;
			parser.authority_range.second = parser.position;

			if(character == ':') {
				parser.state = ParseState::PORT;
				parser.port_range.first = parser.position + 1;
			}
			else if(character == '/') {
				parser.state = ParseState::PATH;
				parser.path_range.first = parser.position;
			}
			else if(character == '?') {
				parser.state = ParseState::SEARCH;
				parser.search_range.first = parser.position + 1;
			}
			else if(character == '#') {
				parser.state = ParseState::FRAGMENT;
				parser.fragment_range.first = parser.position + 1;
			}

			parser.position--;
			return;
		}

		if(character == '.') {
			parser.dot_count++;
			parser.digit_run_length = 0;
		}
		else if(character >= '0' && character <= '9') {
			parser.digit_run_length++;
		}
		else {
			parser.is_ip_address = false;
		}
	}

	static void handle_port(URLParser& parser, char character) {
		if(parser.port_range.first == -1) {
			parser.port_range.first = parser.position;
		}

		if(character == '/') {
			parser.port_range.second = parser.position;
			parser.state = ParseState::PATH;
			parser.path_range.first = parser.position;
		}
		else if(character == '?') {
			parser.port_range.second = parser.position;
			parser.state = ParseState::SEARCH;
			parser.search_range.first = parser.position + 1;
		}
		else if(character == '#') {
			parser.port_range.second = parser.position;
			parser.state = ParseState::FRAGMENT;
			parser.fragment_range.first = parser.position + 1;
		}
	}

	static void handle_path(URLParser& parser, char character) {
		if(parser.path_range.first == -1) {
			parser.path_range.first = parser.position;
		}

		if(character == '?') {
			parser.path_range.second = parser.position;
			parser.state = ParseState::SEARCH;
			parser.search_range.first = parser.position + 1;
		}
		else if(character == '#') {
			parser.path_range.second = parser.position;
			parser.state = ParseState::FRAGMENT;
			parser.fragment_range.first = parser.position + 1;
		}
	}

	static void handle_search(URLParser& parser, char) {
		parser.search_range.first = parser.position;
		parser.state = ParseState::SEARCH_PARAMS;
	}

	static void handle_search_params(URLParser& parser, char character) {
