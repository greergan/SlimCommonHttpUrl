#ifndef SLIM__COMMON__HTTP__URL__H
#define SLIM__COMMON__HTTP__URL__H
#include <string>
#include <string_view>
#include <unordered_map>

#include <slim/common/http/error_codes.h>

#define SLIMCOMMONHTTPURL_VERSION "@SLIMCOMMONHTTPURL_VERSION@"
#define SLIMCOMMONHTTPURL_GIT_HASH "@SLIMCOMMONHTTPURL_GIT_HASH@"

namespace slim::common::http {
    using hints_map = std::unordered_map<std::string, std::pair<int, int>>;

    class URL {
    public:
        URL();
        URL(std::string_view s);
        URL(std::string_view s, const hints_map& hints);

        static ErrorStatus can_parse(std::string_view s, hints_map& hints) noexcept;

        std::string_view hash() const noexcept { return hash_; }
        std::string_view host() const noexcept { return host_; }
        std::string_view hostname() const noexcept { return hostname_; }
        std::string_view href() const noexcept { return href_; }
        std::string_view origin() const noexcept { return origin_; }
        std::string_view password() const noexcept { return password_; }
        std::string_view pathname() const noexcept { return pathname_; }
        std::string_view port() const noexcept { return port_; }
        std::string_view protocol() const noexcept { return protocol_; }
        std::string_view search() const noexcept { return search_; }
        std::string_view searchParams() const noexcept { return searchParams_; }
        std::string_view username() const noexcept { return username_; }

    private:
        void parse(const hints_map& hints) noexcept;
        friend class Request;

        std::string hash_;
        std::string host_;
        std::string hostname_;
        std::string href_;
        std::string origin_;
        std::string password_;
        std::string pathname_;
        std::string port_;
        std::string protocol_;
        std::string search_;
        std::string searchParams_;
        std::string username_;
    };
};
#endif
