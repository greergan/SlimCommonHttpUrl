			parser.state = ParseState::INVALID;
			error_map.set("invalid_protocol_character", std::string("invalid protocol character"));
		}
	}

	static void handle_authority(URLParser& parser, char character) {
		auto error_map = parser.return_value.get_multi_map("errors");

		if(parser.authority_range.first == -1) {
			parser.authority_range.first = parser.position;
		}

		if(character == '/' &&
			parser.position + 1 < parser.url_length &&
			parser.url_string[parser.position + 1] == '/') {

			parser.position++;
			parser.state = ParseState::HOST;
			parser.host_range.first = parser.position + 1;

			parser.is_ip_address = true;
			parser.dot_count = 0;
			parser.digit_run_length = 0;
		}
